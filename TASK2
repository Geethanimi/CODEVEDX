package level1;

class Employee {
	//private keyword for encapsulation
	private int id;
	private String name;
	private String department;
	private int salary;
	
	//contructors for easy
	public Employee(int id, String name,String department, int salary){
		this.id=id;
		this.name=name;
		this.department=department;
		this.salary=salary;
	}
	
	//setter methods
	public void setId(int id) {this.id=id;}
	public void setName(String name) {this.name=name;}
	public void setDepartment(String department) {this.department=department;}
	public void setSalary(int salary) {this.salary=salary;}
	
	//getter methods
	public int getId() {return this.id;}
	public String getName() {return this.name;}
	public String getDepartment() {return this.department;}
	public int getSalary() {return this.salary;}

	public int calculateAnnualSalary() {
		return this.salary*12;
	}
	//overloading calculateAnnualSalary() method
	public int calculateAnnualSalary(int bonus) {
		return this.salary*12+bonus;
	}
	
	public void displayDetails() {
		System.out.println("Employee id: "+this.id);
		System.out.println("Employee name: "+this.name);
		System.out.println("Employee department: "+this.department);
		System.out.println("Employee salary: "+this.salary);
		System.out.println("Employee Annual Salary: "+this.calculateAnnualSalary());
	}
	
	//overriding toString() method
	@Override
	public String toString() {
		return "Employee [ id: "+this.id+ ", name: "+this.name+", department: "+this.department+", salary: "+this.salary+" ].";

	}

}


public class Task2 {
	public static void main(String[] agrs) {
		Employee emp=new Employee(156,"Geetha","Developer",50000);
		
		//calling overrided toString() method
		System.out.println(emp);
		
		//calling method and its overloaded method
		emp.displayDetails();
		System.out.println("Annual Salary without Bonus: "+emp.calculateAnnualSalary());
		System.out.println("Annual Salary with Bonus: "+emp.calculateAnnualSalary(5000));
		
		
	}
}
